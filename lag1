local player = game.Players.LocalPlayer
local char = player.Character or player.CharacterAdded:Wait()
local root = char:WaitForChild("HumanoidRootPart")
local hum = char:WaitForChild("Humanoid")

-- GUI作成
local screenGui = Instance.new("ScreenGui", player.PlayerGui)
local button = Instance.new("TextButton", screenGui)

button.Size = UDim2.new(0, 150, 0, 60)
button.Position = UDim2.new(0.5, -75, 0.7, 0)
button.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
button.Text = "HOLD TO DASH"
button.TextColor3 = Color3.new(1,1,1)
button.Draggable = true

-- 速度制限を抜けるための設定
local speedMultiplier = 3 -- 通常の3倍の速さで移動（調整可能）
local blinking = false

-- ボタンを押している間だけラグを発生させる
button.MouseButton1Down:Connect(function()
    blinking = true
    button.Text = "CHARGING..."
    button.BackgroundColor3 = Color3.fromRGB(255, 100, 0)
    
    -- サーバーへの送信をわざと遅らせる
    settings().Network.IncomingReplicationLag = 1000
    
    -- ラグ中に移動速度を上げる（自分の画面上だけ）
    hum.WalkSpeed = 16 * speedMultiplier
end)

-- ボタンを離した瞬間に同期（ダッシュ完了）
button.MouseButton1Up:Connect(function()
    blinking = false
    button.Text = "DASH!"
    button.BackgroundColor3 = Color3.fromRGB(0, 200, 0)
    
    -- 1. 速度検知による死亡を防ぐためのリセット
    root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
    hum.PlatformStand = true
    
    -- 2. 同期を元に戻して一気にワープ
    settings().Network.IncomingReplicationLag = 0
    hum.WalkSpeed = 16 -- 通常速度に戻す
    
    task.wait(0.1)
    root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
    hum.PlatformStand = false
    
    task.wait(0.5)
    button.Text = "HOLD TO DASH"
    button.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
end)
