local player = game.Players.LocalPlayer
local runService = game:GetService("RunService")

-- 死んでも消えないGUI設定
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "UltraGodGui"
screenGui.Parent = player:WaitForChild("PlayerGui")
screenGui.ResetOnSpawn = false

local button = Instance.new("TextButton", screenGui)
button.Size = UDim2.new(0, 160, 0, 60)
button.Position = UDim2.new(0.5, -80, 0.1, 80)
button.BackgroundColor3 = Color3.fromRGB(60, 0, 0)
button.Text = "ULTRA GOD: OFF"
button.TextColor3 = Color3.new(1, 1, 1)
button.Draggable = true

local godEnabled = false

-- [[ 強化された無敵ロジック ]]
runService.Heartbeat:Connect(function()
    if not godEnabled then return end
    
    local char = player.Character
    if char then
        -- 1. ヒューマノイドの全ダメージステートをロック
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            if hum.Health > 0 and hum.Health < hum.MaxHealth then
                hum.Health = hum.MaxHealth
            end
            hum:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
        end
        
        -- 2. 【強力】当たり判定（Touch）の無効化
        -- キャラクターの全てのパーツから「触れた時にイベントを起こす」機能を奪います
        for _, part in pairs(char:GetChildren()) do
            if part:IsA("BasePart") then
                part.CanTouch = false -- これで罠や攻撃の「接触判定」が消えます
            end
        end
    end
end)

-- [[ 3. 通信（RemoteEvent）の徹底拒絶 ]]
local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()
    if godEnabled and method == "FireServer" then
        local name = self.Name:lower()
        -- ダメージ報告に関連しそうなワードをすべてブロック
        if name:find("damage") or name:find("hit") or name:find("take") or name:find("died") or name:find("health") then
            return nil
        end
    end
    return oldNamecall(self, ...)
end)

button.MouseButton1Click:Connect(function()
    godEnabled = not godEnabled
    button.Text = godEnabled and "ULTRA GOD: ON" or "ULTRA GOD: OFF"
    button.BackgroundColor3 = godEnabled and Color3.fromRGB(255, 0, 0) or Color3.fromRGB(60, 0, 0)
    
    -- OFFにした時は当たり判定を戻す
    if not godEnabled and player.Character then
        for _, part in pairs(player.Character:GetChildren()) do
            if part:IsA("BasePart") then part.CanTouch = true end
        end
    end
end)
