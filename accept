local player = game.Players.LocalPlayer
local runService = game:GetService("RunService")
local char = player.Character or player.CharacterAdded:Wait()
local root = char:WaitForChild("HumanoidRootPart")
local hum = char:WaitForChild("Humanoid")

-- [[ 設定セクション ]]
local TARGET_SPEED = 45 -- 戻される場合は30〜40に下げて調整
local blinkDistance = 2.5 -- 1フレームあたりの移動補正

-- 1. サーバーの監視を騙す（ジャンプ状態を維持）
-- サーバーはジャンプ中の移動には少し寛容なため、状態を偽装します
runService.Stepped:Connect(function()
    if hum.MoveDirection.Magnitude > 0 then
        hum:ChangeState(Enum.HumanoidStateType.Jumping)
    end
end)

-- 2. メモリ上の数値を隠蔽（アンチチート対策）
local oldIndex
oldIndex = hookmetamethod(game, "__index", function(self, key)
    if not checkcaller() and self == hum and key == "WalkSpeed" then
        return 16
    end
    return oldIndex(self, key)
end)

-- 3. 物理的な「戻し」を相殺する移動方式
runService.Heartbeat:Connect(function()
    if hum.MoveDirection.Magnitude > 0 then
        -- 速度(Velocity)を直接上げず、座標(CFrame)を小刻みに書き換える
        -- これによりサーバーの速度検知を回避します
        local newCFrame = root.CFrame + (hum.MoveDirection * (TARGET_SPEED / 60))
        
        -- 物理的な勢い(Velocity)をゼロに固定して「戻される力」を消す
        root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        root.CFrame = newCFrame
    end
end)

print("--- 戻され防止スピードハック 起動 ---")
